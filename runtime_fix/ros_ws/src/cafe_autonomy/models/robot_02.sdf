<?xml version="1.0"?><sdf version="1.10"><model name="robot_02">
    <link name="base_footprint">
    <inertial><mass>12</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.20</izz></inertia></inertial>
    <collision name="caster_front"><pose>0.2 0 -0.13 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
    <collision name="caster_rear"><pose>-0.2 0 -0.13 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
<sensor name="body_contact" type="contact"><always_on>true</always_on><update_rate>30</update_rate><topic>/robot_02/contact_truth</topic><contact><collision>body_collision</collision></contact></sensor>
    <collision name="body_collision"><geometry><box><size>0.52 0.40 0.25</size></box></geometry></collision>
    <visual name="body_visual"><geometry><box><size>0.52 0.40 0.25</size></box></geometry><material><ambient>0.2 0.42 0.75 1</ambient></material></visual>
<sensor name="front_rgb" type="camera"><pose>0.0 0 0.12 0 0 0.0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/robot_02/front/rgb</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
<sensor name="front_depth" type="depth_camera"><pose>0.0 0 0.12 0 0 0.0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/robot_02/front/depth</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
<sensor name="rear_left_rgb" type="camera"><pose>0.0 0 0.12 0 0 2.0943951</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/robot_02/rear_left/rgb</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
<sensor name="rear_left_depth" type="depth_camera"><pose>0.0 0 0.12 0 0 2.0943951</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/robot_02/rear_left/depth</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
<sensor name="rear_right_rgb" type="camera"><pose>0.0 0 0.12 0 0 -2.0943951</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/robot_02/rear_right/rgb</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
<sensor name="rear_right_depth" type="depth_camera"><pose>0.0 0 0.12 0 0 -2.0943951</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/robot_02/rear_right/depth</topic><camera><horizontal_fov>2.0943951</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor>
    <sensor name="gpu_lidar" type="gpu_lidar"><pose>0.06 0 0.16 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate>
      <topic>/robot_02/scan_raw</topic><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.10</min><max>12.0</max><resolution>0.01</resolution></range></lidar></sensor>
  </link>
  <link name="left_wheel"><pose>0 0.175 -0.08 -1.5707963 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></collision>
    <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></visual></link>
  <link name="right_wheel"><pose>0 -0.175 -0.08 -1.5707963 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></collision>
    <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.045</length></cylinder></geometry></visual></link>
  <joint name="left_wheel_joint" type="revolute"><parent>base_footprint</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-100000</lower><upper>100000</upper></limit></axis></joint>
  <joint name="right_wheel_joint" type="revolute"><parent>base_footprint</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-100000</lower><upper>100000</upper></limit></axis></joint>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.35</wheel_separation><wheel_radius>0.10</wheel_radius><topic>/model/robot_02/cmd_vel</topic>
    <odom_topic>/model/robot_02/odometry</odom_topic><frame_id>robot_02/odom</frame_id><child_frame_id>robot_02/base_footprint</child_frame_id>
    <odom_publish_frequency>50</odom_publish_frequency><max_linear_acceleration>0.6</max_linear_acceleration><max_angular_acceleration>1.0</max_angular_acceleration></plugin>
</model></sdf>