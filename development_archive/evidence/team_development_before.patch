diff --git a/ros_ws/src/serving_robot_bringup/launch/multi_robot.launch.py b/ros_ws/src/serving_robot_bringup/launch/multi_robot.launch.py
index e69de29..a9e76cc 100644
--- a/ros_ws/src/serving_robot_bringup/launch/multi_robot.launch.py
+++ b/ros_ws/src/serving_robot_bringup/launch/multi_robot.launch.py
@@ -0,0 +1,35 @@
+"""Opt-in second robot with shared map_server. Needs external Robot02 model/TF."""
+from pathlib import Path
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, OpaqueFunction
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.substitutions import LaunchConfiguration
+
+
+def configure(context):
+    if LaunchConfiguration('robot02_model_ready').perform(context).lower() != 'true':
+        raise ValueError('Robot02 not configured in team Gazebo/TF; explicit model readiness required')
+    path = str(Path(get_package_share_directory('serving_robot_bringup'))/'launch/operation_mode.launch.py')
+    shared = {k:LaunchConfiguration(k) for k in
+              ('map','limits_file','person_policy_file','waypoints_file','arrival_file','use_sim_time','perception_config','start_vision')}
+    return [
+        IncludeLaunchDescription(PythonLaunchDescriptionSource(path),
+            launch_arguments={**shared,'robot_id':'robot_01','start_map_server':'true'}.items()),
+        IncludeLaunchDescription(PythonLaunchDescriptionSource(path),
+            launch_arguments={**shared,'robot_id':'robot_02','start_map_server':'false'}.items()),
+    ]
+
+
+def generate_launch_description():
+    return LaunchDescription([
+        DeclareLaunchArgument('map'),DeclareLaunchArgument('limits_file'),
+        DeclareLaunchArgument('person_policy_file'),
+        DeclareLaunchArgument('perception_config',default_value=''),
+        DeclareLaunchArgument('waypoints_file'),
+        DeclareLaunchArgument('arrival_file',default_value=str(Path(get_package_share_directory('serving_robot_navigation'))/'config/arrival.yaml')),
+        DeclareLaunchArgument('start_vision',default_value='false'),
+        DeclareLaunchArgument('use_sim_time',default_value='true'),
+        DeclareLaunchArgument('robot02_model_ready',default_value='false'),
+        OpaqueFunction(function=configure),
+    ])
diff --git a/ros_ws/src/serving_robot_bringup/launch/operation_mode.launch.py b/ros_ws/src/serving_robot_bringup/launch/operation_mode.launch.py
index e69de29..1f99664 100644
--- a/ros_ws/src/serving_robot_bringup/launch/operation_mode.launch.py
+++ b/ros_ws/src/serving_robot_bringup/launch/operation_mode.launch.py
@@ -0,0 +1,180 @@
+"""Part 2 production entrypoint. Does not start SLAM or people simulator.
+
+Launch requirements: external existing nonempty physical map; explicitly approved
+person-distance policy; installed ROS Jazzy Nav2; robot sensors and TF already up.
+"""
+import os
+from pathlib import Path
+import sys
+import tempfile
+import yaml
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, OpaqueFunction
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+
+
+def _nodes(context):
+    nav = Path(get_package_share_directory('serving_robot_navigation'))
+    perception = Path(get_package_share_directory('serving_robot_perception'))
+    sys.path.insert(0, str(nav / 'launch'))
+    from autonomy_contract import (load_yaml, validate_limits, validate_map,
+                                   validate_person_policy, validate_robot,
+                                   make_nav_params, make_costmap_overrides, replace_robot_literals)
+
+    robot = validate_robot(LaunchConfiguration('robot_id').perform(context))
+    map_file = validate_map(LaunchConfiguration('map').perform(context))
+    limits_path = Path(LaunchConfiguration('limits_file').perform(context))
+    limits = validate_limits(load_yaml(limits_path))
+    policy_path = Path(LaunchConfiguration('person_policy_file').perform(context))
+    policy = validate_person_policy(limits, load_yaml(policy_path))
+    sim = LaunchConfiguration('use_sim_time').perform(context).lower() == 'true'
+    share_map = LaunchConfiguration('start_map_server').perform(context).lower() == 'true'
+    enable_vision = LaunchConfiguration('start_vision').perform(context).lower() == 'true'
+    # Safety stays fail-closed if no vision events are present; no ground-truth default.
+    safety_source = LaunchConfiguration('person_event_topic').perform(context)
+    if not safety_source:
+        safety_source = f'/{robot}/person_safety_event'
+    if 'lab' in safety_source.lower() or 'gazebo' in safety_source.lower():
+        raise ValueError('Ground-truth/LAB person input forbidden in operation mode')
+    arrival_file = Path(LaunchConfiguration('arrival_file').perform(context))
+    arrival = load_yaml(arrival_file)['arrival']
+    nav_data = make_nav_params(load_yaml(nav/'config/nav2.yaml'), robot, policy, nav, arrival)
+    costmap_overrides = make_costmap_overrides(nav_data, robot, sim)
+    collision = replace_robot_literals(load_yaml(nav/'config/collision_monitor.yaml'), robot)
+    amcl_data = replace_robot_literals(load_yaml(nav/'config/amcl.yaml'), robot)
+    # Match the existing absolute parameter-node patterns of this LAB source.
+    amcl_cfg = amcl_data.get(f'/{robot}/amcl', {}).get('ros__parameters', {})
+    if not amcl_cfg:
+        raise ValueError('AMCL parameter block missing')
+    amcl_cfg['use_sim_time'] = sim
+    if robot == 'robot_02':
+        amcl_cfg['base_frame_id'] = 'robot_02/base_footprint'
+        amcl_cfg['odom_frame_id'] = 'robot_02/odom'
+    collision_cfg = collision.get(f'/{robot}/collision_monitor', {}).get('ros__parameters', {})
+    if not collision_cfg:
+        raise ValueError('Collision Monitor parameter block missing')
+    collision_cfg['use_sim_time'] = sim
+    if robot == 'robot_02':
+        collision_cfg['base_frame_id'] = 'robot_02/base_footprint'
+        collision_cfg['odom_frame_id'] = 'robot_02/odom'
+    collision_cfg['cmd_vel_in_topic'] = f'/{robot}/cmd_vel_semantic'
+    collision_cfg['cmd_vel_out_topic'] = f'/{robot}/cmd_vel'
+    # Effective limits are generated outside the team common file, once per launch.
+    effective_limits = tempfile.NamedTemporaryFile(
+        prefix=f'{robot}_effective_limits_', suffix='.yaml', mode='w', delete=False)
+    yaml.safe_dump(policy, effective_limits)
+    effective_limits.close()
+
+    def node(package, executable, name=None, params=(), remappings=(), namespace=None):
+        return Node(package=package, executable=executable, name=name or executable,
+                    namespace=namespace if namespace is not None else robot,
+                    output='screen', parameters=list(params), remappings=list(remappings))
+
+    items = []
+    if share_map:
+        items.extend([
+            node('nav2_map_server', 'map_server', namespace='', params=[{
+                'yaml_filename': str(map_file), 'use_sim_time': sim,
+            }]),
+            node('nav2_lifecycle_manager','lifecycle_manager',
+                 name='lifecycle_manager_map',namespace='',params=[{
+                     'node_names': ['map_server'], 'autostart': True, 'use_sim_time': sim,
+                 }]),
+        ])
+    items.extend([
+        node('nav2_amcl','amcl',params=[amcl_cfg],remappings=[
+             ('scan', f'/{robot}/scan'),('map','/map'),
+             ('initialpose',f'/{robot}/initialpose')]),
+        node('nav2_lifecycle_manager','lifecycle_manager',
+             name='lifecycle_manager_localization',params=[{
+                'node_names':['amcl'],'autostart':True,'use_sim_time':sim,
+             }]),
+    ])
+    stack = [
+        ('nav2_planner','planner_server', []),
+        ('nav2_controller','controller_server',[('cmd_vel',f'/{robot}/cmd_vel_nav')]),
+        ('nav2_behaviors','behavior_server',[('cmd_vel',f'/{robot}/cmd_vel_nav')]),
+        ('nav2_bt_navigator','bt_navigator',[]),
+        ('nav2_velocity_smoother','velocity_smoother',
+             [('cmd_vel',f'/{robot}/cmd_vel_nav')]),
+    ]
+    for package, executable, remaps in stack:
+        p = nav_data[executable]['ros__parameters']
+        # Global static layer must read the shared root map, not /robot_01/map.
+        if executable == 'planner_server':
+            remaps = list(remaps) + [('map', '/map'), (f'/{robot}/map', '/map')]
+        # Node parameter overrides for costmap child nodes reside in a distinct file.
+        if executable in ('controller_server', 'planner_server'):
+            nested_file = tempfile.NamedTemporaryFile(
+                prefix=f'{robot}_{executable}_', suffix='.yaml',mode='w',delete=False)
+            # No guessed flat costmap: use validated nested source.
+            nested = costmap_overrides
+            yaml.safe_dump(nested, nested_file)
+            nested_file.close()
+            params = [nested_file.name, p, {'use_sim_time':sim}]
+        else:
+            params = [p, {'use_sim_time':sim}]
+        items.append(node(package,executable,params=params,remappings=remaps))
+    items.append(node('nav2_lifecycle_manager','lifecycle_manager',
+        name='lifecycle_manager_navigation',params=[{
+          'node_names':[x[1] for x in stack], 'autostart':True,'use_sim_time':sim,
+        }]))
+    # This chain has exactly one final robot base publisher: collision_monitor.
+    items.append(node('serving_robot_perception','semantic_safety',
+         params=[{'robot_id':robot,'person_event_topic':safety_source,
+                  'limits_file':effective_limits.name,
+                  'sensor_timeout_s':float(LaunchConfiguration('sensor_timeout_s').perform(context)),
+                  'use_sim_time':sim}]))
+    items.extend([
+        node('nav2_collision_monitor','collision_monitor',params=[collision_cfg]),
+        node('nav2_lifecycle_manager','lifecycle_manager',name='lifecycle_manager_collision',
+             params=[{'node_names':['collision_monitor'], 'autostart':True,'use_sim_time':sim}]),
+    ])
+    waypoints_file = LaunchConfiguration('waypoints_file').perform(context)
+    if not waypoints_file or not Path(waypoints_file).is_file() or not Path(waypoints_file).stat().st_size:
+        raise ValueError('Real/Mock Semantic waypoint file is required; never modify Mapping source')
+    items.append(node('serving_robot_navigation','destination_server.py',name='destination_server',
+         params=[{'robot_id':robot,'waypoints_file':waypoints_file,
+                  'arrival_file':str(arrival_file), 'use_sim_time':sim}]))
+    items.append(node('serving_robot_navigation','blockage_node.py',name='blockage_monitor',
+         params=[{'robot_id':robot,'policy_file':str(nav/'config/blockage_policy.yaml'),
+                  'use_sim_time':sim}]))
+    if enable_vision:
+        config_path = LaunchConfiguration('perception_config').perform(context)
+        vision_cfg = load_yaml(config_path)
+        cameras = vision_cfg.get('cameras')
+        if not isinstance(cameras,list) or len(cameras)!=3 or any(
+                not isinstance(c,dict) or not c.get('rgb_topic') or not c.get('depth_topic')
+                for c in cameras):
+            raise ValueError('Require 3 explicit, real RGB + registered-depth topics')
+        items.extend([
+            node('serving_robot_perception','person_detector',params=[{
+                'robot_id':robot,'config_file':config_path,'use_sim_time':sim,
+            }]),
+            node('serving_robot_perception','depth_fusion',params=[{
+                'robot_id':robot,'config_file':config_path,'use_sim_time':sim,
+            }]),
+        ])
+    return items
+
+
+def generate_launch_description():
+    return LaunchDescription([
+        DeclareLaunchArgument('robot_id',default_value='robot_01'),
+        DeclareLaunchArgument('map',description='Existing real Map Server map.yaml (required)'),
+        DeclareLaunchArgument('limits_file',description='TEAM common runtime_limits.yaml (required)'),
+        DeclareLaunchArgument('person_policy_file',
+                              description='Explicit TEAM APPROVED 2.5m safety policy (required)'),
+        DeclareLaunchArgument('perception_config', default_value=''),
+        DeclareLaunchArgument('person_event_topic',default_value=''),
+        DeclareLaunchArgument('waypoints_file',description='Read-only Semantic waypoints.yaml (required)'),
+        DeclareLaunchArgument('arrival_file',default_value=str(Path(get_package_share_directory('serving_robot_navigation'))/'config/arrival.yaml')),
+        DeclareLaunchArgument('use_sim_time',default_value='true'),
+        DeclareLaunchArgument('start_map_server',default_value='true'),
+        DeclareLaunchArgument('start_vision',default_value='false'),
+        DeclareLaunchArgument('sensor_timeout_s',default_value='1.0'),
+        OpaqueFunction(function=_nodes),
+    ])
