diff --git a/ros_ws/src/serving_robot_perception/serving_robot_perception/depth_fusion.py b/ros_ws/src/serving_robot_perception/serving_robot_perception/depth_fusion.py
index e69de29..e9b3ea6 100644
--- a/ros_ws/src/serving_robot_perception/serving_robot_perception/depth_fusion.py
+++ b/ros_ws/src/serving_robot_perception/serving_robot_perception/depth_fusion.py
@@ -0,0 +1,115 @@
+"""Registered depth + per-camera YOLO bounding box fusion; fail-closed aggregator.
+
+Range is optical depth, not a team-approved center/surface distance reference.
+Do not claim it satisfies the unresolved team 2.5m geometric interpretation.
+"""
+import json
+import math
+import time
+from pathlib import Path
+import yaml
+
+
+def min_person_depth(depth, boxes):
+    """depth is metric float numpy array; return nearest positive median bbox depth."""
+    import numpy as np
+    nearest=[]
+    h,w=depth.shape[:2]
+    for box in boxes:
+        if not isinstance(box,(list,tuple)) or len(box)!=4:continue
+        x1,y1,x2,y2=[int(float(v)) for v in box]
+        x1=max(0,min(w,x1));x2=max(0,min(w,x2))
+        y1=max(0,min(h,y1));y2=max(0,min(h,y2))
+        if x2<=x1 or y2<=y1:continue
+        part=depth[y1:y2,x1:x2]
+        valid=part[np.isfinite(part)&(part>0)]
+        if valid.size:nearest.append(float(np.percentile(valid,25)))
+    return min(nearest) if nearest else None
+
+
+def main(args=None):
+    import numpy as np
+    import rclpy
+    from cv_bridge import CvBridge
+    from rclpy.node import Node
+    from rclpy.qos import qos_profile_sensor_data
+    from sensor_msgs.msg import Image
+    from std_msgs.msg import String
+    from serving_robot_interfaces.msg import PersonSafetyEvent
+    from serving_robot_perception.person_detector import validate_cameras
+
+    class Fusion(Node):
+        def __init__(self):
+            super().__init__('depth_fusion')
+            self.robot=self.declare_parameter('robot_id','robot_01').value
+            cfg=yaml.safe_load(Path(self.declare_parameter('config_file','').value).read_text())
+            cams=validate_cameras(cfg)
+            self.timeout=float(cfg.get('sensor_timeout_s',1.0))
+            if not math.isfinite(self.timeout) or self.timeout<=0:
+                raise ValueError('sensor timeout must be finite and >0')
+            self.max_skew=float(cfg.get('max_rgb_depth_skew_s',.15))
+            if not math.isfinite(self.max_skew) or self.max_skew<=0:raise ValueError('Invalid image synchronization tolerance')
+            self.bridge=CvBridge()
+            self.detections={}
+            self.depth={}
+            self.pub=self.create_publisher(PersonSafetyEvent,f'/{self.robot}/person_safety_event',10)
+            self.det_sub=self.create_subscription(String,f'/{self.robot}/person_detections',self.detect,10)
+            self.subs=[self.create_subscription(Image,cam['depth_topic'],
+                       lambda msg,i=i:self.on_depth(msg,i),qos_profile_sensor_data) for i,cam in enumerate(cams)]
+            self.timer=self.create_timer(0.1,self.publish)
+        def detect(self,msg):
+            try:
+                data=json.loads(msg.data);i=data['camera']; assert i in range(3)
+                assert isinstance(data.get('boxes'),list)
+                self.detections[i]=(data,time.monotonic())
+            except Exception as e:
+                self.get_logger().warning(f'Invalid detection event: {e}')
+        def on_depth(self,msg,index):
+            try:
+                mat=self.bridge.imgmsg_to_cv2(msg,desired_encoding='passthrough')
+                if len(mat.shape)!=2:raise ValueError('Depth image not single channel')
+                if msg.encoding=='16UC1':mat=mat.astype(np.float32)*.001
+                elif msg.encoding=='32FC1':mat=mat.astype(np.float32)
+                else:raise ValueError('Depth image must be 16UC1 or 32FC1')
+                stamp=int(msg.header.stamp.sec)*10**9+int(msg.header.stamp.nanosec)
+                self.depth[index]=(mat,time.monotonic(),msg.width,msg.height,stamp)
+            except Exception as e:
+                self.get_logger().warning(f'Invalid depth frame {index}: {e}')
+        def publish(self):
+            now=time.monotonic()
+            event=PersonSafetyEvent()
+            event.header.stamp=self.get_clock().now().to_msg()
+            event.header.frame_id='map'
+            event.robot_id=self.robot
+            event.state='SENSOR_STALE';event.distance_m=float('nan');event.confidence=0.0
+            fresh=all(i in self.depth and i in self.detections and
+                      now-self.depth[i][1]<=self.timeout and
+                      now-self.detections[i][1]<=self.timeout
+                      for i in range(3))
+            if fresh:
+                distances=[];detected=False;geometry_ok=True
+                for i in range(3):
+                    det=self.detections[i][0];dep=self.depth[i]
+                    if (dep[2]!=det['width'] or dep[3]!=det['height'] or
+                        abs(dep[4]-det['stamp_ns']) > self.max_skew*1e9):
+                        geometry_ok=False;break  # RGB/depth not registered; do not guess rescale
+                    if det['boxes']:
+                        detected=True
+                        dist=min_person_depth(dep[0],det['boxes'])
+                        if dist is None:geometry_ok=False;break
+                        distances.append(dist)
+                if geometry_ok:
+                    event.state='NORMAL' if not detected else 'SLOW'
+                    # Semantic Safety applies APPROVED STOP/SLOW thresholds downstream.
+                    event.distance_m=float(min(distances)) if distances else float('inf')
+                    event.confidence=1.0
+            self.pub.publish(event)
+    rclpy.init(args=args)
+    node=None
+    try:
+        node=Fusion();rclpy.spin(node)
+    finally:
+        if node:node.destroy_node()
+        if rclpy.ok():rclpy.shutdown()
+
+if __name__=='__main__':main()
diff --git a/ros_ws/src/serving_robot_perception/serving_robot_perception/person_detector.py b/ros_ws/src/serving_robot_perception/serving_robot_perception/person_detector.py
index e69de29..d3a471f 100644
--- a/ros_ws/src/serving_robot_perception/serving_robot_perception/person_detector.py
+++ b/ros_ws/src/serving_robot_perception/serving_robot_perception/person_detector.py
@@ -0,0 +1,75 @@
+"""3-camera RGB person detector, independent of Gazebo ground-truth.
+
+Emits camera image bounding boxes. It does not assert metric range or safety state.
+YOLO dependency is loaded at runtime only, when sensors and local weights exist.
+"""
+import json
+from pathlib import Path
+import time
+import yaml
+
+def validate_cameras(config):
+    cams = config.get('cameras') if isinstance(config,dict) else None
+    if not isinstance(cams,list) or len(cams)!=3:
+        raise ValueError('Requires 3 configured RGB+depth cameras')
+    for camera in cams:
+        if not isinstance(camera,dict) or not all(camera.get(k) for k in ('rgb_topic','depth_topic')):
+            raise ValueError('Camera topics must match real robot model')
+    if len({c['rgb_topic'] for c in cams}) != 3:
+        raise ValueError('RGB camera topics must be unique')
+    return cams
+
+
+def main(args=None):
+    import rclpy
+    from cv_bridge import CvBridge
+    from rclpy.node import Node
+    from rclpy.qos import qos_profile_sensor_data
+    from sensor_msgs.msg import Image
+    from std_msgs.msg import String
+
+    class Detector(Node):
+        def __init__(self):
+            super().__init__('person_detector')
+            self.robot = self.declare_parameter('robot_id','robot_01').value
+            config_path = self.declare_parameter('config_file','').value
+            cfg = yaml.safe_load(Path(config_path).read_text())
+            self.cameras = validate_cameras(cfg)
+            weights = cfg.get('model_path')
+            if not weights or not Path(weights).is_file():
+                raise ValueError('Set model_path to installed YOLO weights; no auto-download')
+            from ultralytics import YOLO
+            self.model = YOLO(weights)
+            self.conf = float(cfg.get('confidence',0.4))
+            if not 0 < self.conf < 1:
+                raise ValueError('Invalid detector confidence')
+            self.bridge = CvBridge()
+            self.out = self.create_publisher(String,f'/{self.robot}/person_detections',10)
+            self.subs = [self.create_subscription(Image,cam['rgb_topic'],
+                          lambda msg,i=i:self.cb(msg,i),qos_profile_sensor_data)
+                         for i,cam in enumerate(self.cameras)]
+        def cb(self, msg, index):
+            try:
+                image = self.bridge.imgmsg_to_cv2(msg,desired_encoding='bgr8')
+                boxes=[]
+                for result in self.model.predict(source=image,verbose=False,conf=self.conf):
+                    for bbox in result.boxes:
+                        if int(bbox.cls[0]) == 0:
+                            boxes.append([float(v) for v in bbox.xyxy[0].tolist()])
+                payload = {'camera':index,'boxes':boxes,'width':int(msg.width),
+                           'height':int(msg.height),'stamp_ns':int(msg.header.stamp.sec)*10**9+
+                           int(msg.header.stamp.nanosec)}
+                self.out.publish(String(data=json.dumps(payload)))
+            except Exception as exc:
+                self.get_logger().error(f'RGB detection failed camera {index}: {exc}')
+                # No fake NORMAL on failure. Depth fusion will output SENSOR_STALE.
+    rclpy.init(args=args)
+    node=None
+    try:
+        node=Detector();rclpy.spin(node)
+    finally:
+        if node:node.destroy_node()
+        if rclpy.ok():rclpy.shutdown()
+
+if __name__=='__main__':
+    main()
diff --git a/ros_ws/src/serving_robot_perception/serving_robot_perception/semantic_safety.py b/ros_ws/src/serving_robot_perception/serving_robot_perception/semantic_safety.py
index e69de29..ebc1780 100644
--- a/ros_ws/src/serving_robot_perception/serving_robot_perception/semantic_safety.py
+++ b/ros_ws/src/serving_robot_perception/serving_robot_perception/semantic_safety.py
@@ -0,0 +1,42 @@
+import math
+
+
+def decide_state(distance, detected, fresh, limits):
+    if not fresh:
+        return "SENSOR_STALE"
+
+    if not detected:
+        return "NORMAL"
+
+    if distance is None or not math.isfinite(distance) or distance < 0:
+        return "SENSOR_STALE"
+
+    if distance < limits["person_stop_distance_m"]:
+        return "STOP"
+
+    if distance <= limits["person_slow_distance_m"]:
+        return "SLOW"
+
+    return "NORMAL"
+
+
+def filter_velocity(linear, angular, state, limits):
+    if state not in ("NORMAL", "SLOW"):
+        return 0.0, 0.0
+
+    if not math.isfinite(linear) or not math.isfinite(angular):
+        return 0.0, 0.0
+
+    max_v = limits["max_linear_mps"]
+    max_w = limits["max_angular_rps"]
+
+    # 후진 금지
+    linear = max(0.0, min(linear, max_v))
+
+    # 좌우 제자리 회전 허용
+    angular = max(-max_w, min(angular, max_w))
+
+    if state == "SLOW":
+        linear = min(linear, limits["slow_linear_mps"])
+
+    return linear, angular
