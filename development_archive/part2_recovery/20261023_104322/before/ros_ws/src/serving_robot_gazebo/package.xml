<?xml version='1.0' encoding='utf-8'?>
<package format="3">

  <name>serving_robot_gazebo</name>
  <version>0.1.0</version>

  <description>
    Gazebo Harmonic simulation worlds, models, bridges,
    and launch files for the serving robot system.
  </description>

  <maintainer email="notihwan08@gmail.com">hwanote</maintainer>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  

  <exec_depend>serving_robot_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

<depend>rclcpp</depend><depend>tf2_msgs</depend><depend>gz_transport_vendor</depend><depend>gz_msgs_vendor</depend><depend>gz_sim_vendor</depend><depend>gz_plugin_vendor</depend>  <depend>rosgraph_msgs</depend>
</package>