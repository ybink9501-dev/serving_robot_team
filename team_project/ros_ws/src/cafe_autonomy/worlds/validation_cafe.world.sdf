<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">

  <world name="cafe">

    
    
    

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>


    
    
    

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>

    
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>


    
    
    

    <light type="directional" name="sun">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>0.9 0.9 0.9 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>

      <direction>-0.5 0.3 -1.0</direction>

    </light>


    
    
    

    <model name="ground_plane">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>

          </geometry>

        </collision>


        <visual name="ground_visual">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>

          </geometry>

          <material>
            <ambient>0.70 0.70 0.68 1.0</ambient>
            <diffuse>0.78 0.78 0.75 1.0</diffuse>
          </material>

        </visual>

      </link>

    </model>


    
    
    
    
    
    
    

    <model name="north"><static>true</static><pose>0 3.5 1.0 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>10.2 0.2 2.0</size></box></geometry><material><diffuse>.7 .7 .7 1</diffuse><ambient>.7 .7 .7 1</ambient></material></visual></link></model><model name="south"><static>true</static><pose>0 -3.5 1.0 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>10.2 0.2 2.0</size></box></geometry><material><diffuse>.7 .7 .7 1</diffuse><ambient>.7 .7 .7 1</ambient></material></visual></link></model><model name="west"><static>true</static><pose>-5 0 1.0 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.2 7.0 2.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 7.0 2.0</size></box></geometry><material><diffuse>.7 .7 .7 1</diffuse><ambient>.7 .7 .7 1</ambient></material></visual></link></model><model name="east"><static>true</static><pose>5 0 1.0 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.2 7.0 2.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 7.0 2.0</size></box></geometry><material><diffuse>.7 .7 .7 1</diffuse><ambient>.7 .7 .7 1</ambient></material></visual></link></model><model name="corridor_north"><static>true</static><pose>0 0.65 0.6 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>2.0 0.2 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 0.2 1.2</size></box></geometry><material><diffuse>.7 .7 .7 1</diffuse><ambient>.7 .7 .7 1</ambient></material></visual></link></model><model name="corridor_south"><static>true</static><pose>0 -0.65 0.6 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>2.0 0.2 1.2</size><