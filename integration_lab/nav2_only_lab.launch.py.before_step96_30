from pathlib import Path
import yaml

from launch import LaunchDescription
from launch_ros.actions import Node
from launch_ros.descriptions import ParameterFile
from nav2_common.launch import RewrittenYaml


def generate_launch_description():
    home = Path.home()
    config = home / (
        "team_robot_lab/ros_ws/src/"
        "serving_robot_navigation/config/nav2.yaml"
    )
    limits_file = home / (
        "team_robot_lab/config/common/runtime_limits.yaml"
    )

    assert config.is_file(), f"Nav2 config missing: {config}"
    assert limits_file.is_file(), f"Limits missing: {limits_file}"

    limits = yaml.safe_load(limits_file.read_text())
    linear = float(limits["max_linear_mps"])
    angular = float(limits["max_angular_rps"])

    params = ParameterFile(
        RewrittenYaml(
            source_file=str(config),
            root_key="robot_01",
            param_rewrites={},
            convert_types=True,
        ),
        allow_substs=True,
    )

    definitions = [
        ("nav2_planner", "planner_server", "planner_server"),
        ("nav2_controller", "controller_server", "controller_server"),
        ("nav2_behaviors", "behavior_server", "behavior_server"),
        ("nav2_bt_navigator", "bt_navigator", "bt_navigator"),
    ]

    actions = []

    for package, executable, name in definitions:
        overrides = {"use_sim_time": True}

        if name == "controller_server":
            overrides.update({
                "enable_stamped_cmd_vel": False,
                "FollowPath.vx_max": linear,
                "FollowPath.vx_min": 0.0,
                "FollowPath.vy_max": 0.0,
                "FollowPath.wz_max": angular,
            })

        if name == "behavior_server":
            overrides.update({
                "enable_stamped_cmd_vel": False,
                "max_rotational_vel": angular,
            })

        remappings = []

        if name in ("controller_server", "behavior_server"):
            remappings.append(("cmd_vel", "cmd_vel_nav"))

        actions.append(
            Node(
                package=package,
                executable=executable,
                name=name,
                namespace="robot_01",
                output="screen",
                parameters=[params, overrides],
                remappings=remappings,
            )
        )

    actions.append(
        Node(
            package="nav2_lifecycle_manager",
            executable="lifecycle_manager",
            name="lifecycle_manager_navigation_lab",
            namespace="robot_01",
            output="screen",
            parameters=[{
                "use_sim_time": True,
                "autostart": True,
                "node_names": [
                    "planner_server",
                    "controller_server",
                    "behavior_server",
                    "bt_navigator",
                ],
            }],
        )
    )

    return LaunchDescription(actions)
