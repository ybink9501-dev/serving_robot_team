#!/usr/bin/env python3
"""Safe LAB-only Robot01 Gazebo -> AMCL initialpose correction.

Only --apply publishes /initialpose; NEVER publishes cmd_vel/goals or changes code/YAML.
Inapplicable to a production robot or a non-SDF-aligned map.
"""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time

import yaml
from geometry import parse_gz_model_pose, pose_difference, quaternion_yaw, footprint_free, allowed_state

V3=Path.home()/'team_robot_lab/serving_v3'

def fail(reason):
    print('NO_CHANGE:',reason,flush=True)
    return 2

def expand(p):return Path(os.path.expandvars(os.path.expanduser(str(p)))).resolve()

def check_layout():
    config=yaml.safe_load((V3/'layout.yaml').read_text(encoding='utf8'))
    align=config['frame_alignment']
    values=align['world_to_map']
    if config.get('robot_id')!='robot_01' or align.get('mode')!='sdf_aligned_lab_only' or any(abs(float(values[k]))>1.e-6 for k in ('x','y','yaw')):
        raise ValueError('V3 layout NOT Gazebo-world aligned: no pose reset')
    manifest=json.loads((V3/'generated/manifest.json').read_text(encoding='utf8'))
    if config['map_revision']!=manifest['map_revision']:
        raise ValueError('Map revision mismatch')
    world=expand(config['world_file']); mapyaml=expand(config['map_file'])
    if manifest['world']!=str(world) or manifest['map']!=str(mapyaml):
        raise ValueError('World/map source path mismatch')
    for path,key in ((world,'world_sha256'),(mapyaml,'map_yaml_sha256')):
        if hashlib.sha256(path.read_bytes()).hexdigest()!=manifest[key]:
            raise ValueError('Source map/world has changed; refuse reset')
    return config,manifest

def gazebo_pose():
    r=subprocess.run(['gz','model','-m','robot_01','-p'],capture_output=True,text=True,timeout=12)
    if r.returncode!=0:raise RuntimeError('gz model query failed: '+(r.stderr or r.stdout)[-500:])
    return parse_gz_model_pose(r.stdout+'\n'+r.stderr)

def run(apply):
    if os.environ.get('ROS_DOMAIN_ID')!='99' or os.environ.get('GZ_PARTITION')!='team_robot_lab_gazebo_99':
        return fail('Expected isolated LAB ROS_DOMAIN_ID=99 and GZ_PARTITION=team_robot_lab_gazebo_99')
    try:_,manifest=check_layout()
    except Exception as exc:return fail('Source map verification failed: '+str(exc))
    import rclpy
    from rclpy.node import Node
    from rclpy.parameter import Parameter
    from nav_msgs.msg import OccupancyGrid,Odometry
    from geometry_msgs.msg import PoseWithCovarianceStamped
    from action_msgs.msg import GoalStatusArray
    from std_msgs.msg import String
    from rclpy.qos import QoSProfile,DurabilityPolicy,ReliabilityPolicy
    from tf2_ros import Buffer,TransformListener
    from rclpy.time import Time
    rclpy.init()
    node=Node('robot01_localization_recovery_v8')
    node.set_parameters([Parameter('use_sim_time', value=True)])
    status=[];odom=[];goal=[];maps=[]
    mapq=QoSProfile(depth=1,durability=DurabilityPolicy.TRANSIENT_LOCAL,reliability=ReliabilityPolicy.RELIABLE)
    goalq=QoSProfile(depth=10,durability=DurabilityPolicy.TRANSIENT_LOCAL,reliability=ReliabilityPolicy.RELIABLE)
    node.create_subscription(String,'/robot_01/serving/status',lambda m:status.append(json.loads(m.data)),10)
    node.create_subscription(Odometry,'/robot_01/odom',lambda m:odom.append(m),10)
    node.create_subscription(GoalStatusArray,'/robot_01/navigate_to_pose/_action/status',lambda m:goal.append(m),goalq)
    node.create_subscription(OccupancyGrid,'/map',lambda m:maps.append(m),mapq)
    tf=Buffer();listener=TransformListener(tf,node)
    pub=node.create_publisher(PoseWithCovarianceStamped,'/initialpose',10)
    def spin(sec):
        end=time.monotonic()+sec
        while time.monotonic()<end:rclpy.spin_once(node,timeout_sec=.1)
    def pose_tf():
        t=tf.lookup_transform('map','base_footprint',Time())
        return (t.transform.translation.x,t.transform.translation.y,quaternion_yaw(t.transform.rotation))
    try:
        deadline=time.monotonic()+10
        before=None
        while time.monotonic()<deadline:
            rclpy.spin_once(node,timeout_sec=.1)
            if status and odom and goal and maps:
                try:before=pose_tf();break
                except Exception:pass
        if before is None:return fail('Missing live status, odom, action status, /map, or map TF')
        if not allowed_state(status[-1]):return fail('V3 serving not in a safe non-running state: '+str(status[-1]))
        if any(s.status in (1,2,3) for s in goal[-1].status_list):return fail('Nav2 has an active or canceling goal')
        # Distinct odom samples; also check during publish after conditions.
        if len(odom)<3:return fail('Insufficient Odometry samples')
        for m in odom[-3:]:
            twist=m.twist.twist
            if abs(twist.linear.x)>.01 or abs(twist.linear.y)>.01 or abs(twist.angular.z)>.01:
                return fail('Robot moving; no pose reset')
        gm=maps[-1]
        expected=manifest['map_info']
        if (gm.info.width!=expected['width'] or gm.info.height!=expected['height'] or
            abs(gm.info.resolution-expected['resolution'])>1e-5 or
            abs(gm.info.origin.position.x-expected['origin'][0])>1e-3 or
            abs(gm.info.origin.position.y-expected['origin'][1])>1e-3):
            return fail('Live ROS /map does not match reviewed SDF map manifest')
        truth=gazebo_pose()
        if not footprint_free(gm,truth[0],truth[1]):return fail('Gazebo pose not safely free on LAB map; map/geometry inconsistency')
        xy,yaw=pose_difference(before,truth)
        print('BEFORE:',json.dumps({'gazebo_world':[round(x,4) for x in truth],
             'ros_map':[round(x,4) for x in before], 'position_error_m':round(xy,4),
             'yaw_error_deg':round(yaw,2),'map_revision':manifest['map_revision']},ensure_ascii=False),flush=True)
        if not apply:
            print('READ_ONLY: rerun with --apply after confirming no movement',flush=True)
            return 0
        if xy<=.10 and yaw<=10:
            print('ALREADY_ALIGNED: no /initialpose sent',flush=True)
            return 0
        timeout=time.monotonic()+5
        while pub.get_subscription_count()<1 and time.monotonic()<timeout:spin(.15)
        if pub.get_subscription_count()<1:return fail('AMCL /initialpose subscription not found; no reset')
        # Recheck active state at the moment of the one permitted write.
        if not allowed_state(status[-1]) or any(s.status in (1,2,3) for s in goal[-1].status_list):
            return fail('Mission became active during check; no reset')
        twist=odom[-1].twist.twist
        if abs(twist.linear.x)>.01 or abs(twist.angular.z)>.01:return fail('Robot moved; no reset')
        newtruth=gazebo_pose()
        delta,_=pose_difference(newtruth,truth)
        if delta>.03:return fail('Gazebo model moved during check; no reset')
        msg=PoseWithCovarianceStamped()
        msg.header.frame_id='map'
        msg.header.stamp=node.get_clock().now().to_msg()
        msg.pose.pose.position.x=newtruth[0];msg.pose.pose.position.y=newtruth[1]
        msg.pose.pose.orientation.z=math.sin(newtruth[2]/2)
        msg.pose.pose.orientation.w=math.cos(newtruth[2]/2)
        msg.pose.covariance[0]=0.1**2
        msg.pose.covariance[7]=0.1**2
        msg.pose.covariance[35]=math.radians(10)**2
        pub.publish(msg)
        print('PUBLISHED: /initialpose (simulation-only ground truth), no cmd_vel/goal sent',flush=True)
        best=None
        stable_since=None
        end=time.monotonic()+14
        while time.monotonic()<end:
            spin(.2)
            try:
                now=pose_tf();actual=gazebo_pose()
                ex,ey=pose_difference(now,actual)
                if best is None or ex<best[0]:best=ex,ey,now,actual
                if ex<=.15 and ey<=12:
                    if stable_since is None:stable_since=time.monotonic()
                    if time.monotonic()-stable_since>=2.0:
                        print('PASS: AMCL pose stable within 0.15m / 12deg for >=2 seconds',flush=True)
                        print('AFTER:',json.dumps({'map_pose':list(map(lambda x:round(x,4),now)),
                              'world_pose':list(map(lambda x:round(x,4),actual)),
                              'error_m':round(ex,4),'error_deg':round(ey,2)}),flush=True)
                        return 0
                else:
                    stable_since=None
            except Exception:stable_since=None
        print('CHECK: /initialpose published but localization NOT verified; do not send START',flush=True)
        if best:print('BEST_ERROR:',round(best[0],3),'m',round(best[1],1),'deg',flush=True)
        return 3
    except Exception as exc:
        return fail(type(exc).__name__+': '+str(exc))
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__=='__main__':
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--apply',action='store_true',help='Publish exactly one simulation-only initialpose after safety checks')
    args=p.parse_args()
    sys.exit(run(args.apply))
