from pathlib import Path
import yaml

from launch import LaunchDescription
from launch_ros.actions import Node

ROOT = Path.home() / "team_robot_lab"
NAV = ROOT / "ros_ws/src/serving_robot_navigation"

NAV2 = NAV / "config/nav2.yaml"
COLLISION = NAV / "config/collision_monitor_gazebo_lab.yaml"
LIMITS = ROOT / "config/common/runtime_limits.yaml"


def generate_launch_description():
    for path in (NAV2, COLLISION, LIMITS):
        if not path.is_file():
            raise FileNotFoundError(path)

    nav2 = yaml.safe_load(NAV2.read_text())
    limits = yaml.safe_load(LIMITS.read_text())

    smoother = dict(
        nav2["velocity_smoother"]["ros__parameters"]
    )

    max_v = float(limits["max_linear_mps"])
    max_w = float(limits["max_angular_rps"])

    if not (0 < max_v <= 1.0 and 0 < max_w <= 3.0):
        raise ValueError("속도 제한 설정 확인 필요")

    smoother.update({
        "max_velocity": [max_v, 0.0, max_w],
        "min_velocity": [0.0, 0.0, -max_w],
        "feedback": "OPEN_LOOP",
        "use_sim_time": True,
    })

    return LaunchDescription([
        Node(
            package="nav2_velocity_smoother",
            executable="velocity_smoother",
            namespace="robot_01",
            name="velocity_smoother",
            parameters=[smoother],
            remappings=[("cmd_vel", "cmd_vel_nav")],
            output="screen",
        ),
        Node(
            package="serving_robot_perception",
            executable="semantic_safety",
            namespace="robot_01",
            name="semantic_safety",
            parameters=[{
                "robot_id": "robot_01",
                "person_event_topic":
                    "/robot_01/person_safety_event_lab",
                "limits_file": str(LIMITS),
                "sensor_timeout_s": 1.0,
                "use_sim_time": True,
            }],
            output="screen",
        ),
        Node(
            package="nav2_collision_monitor",
            executable="collision_monitor",
            namespace="robot_01",
            name="collision_monitor",
            parameters=[
                str(COLLISION),
                {"use_sim_time": True},
            ],
            output="screen",
        ),
    ])
